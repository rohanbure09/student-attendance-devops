pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir('attendance-system-java') {
                    bat 'test.bat'
                }
            }
        }

        stage('Deploy') {
    steps {
        dir('attendance-system-java') {
            bat '''
                powershell -Command "$p = Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'java.exe' -and $_.CommandLine -like '*attendance.jar*' }; if ($p) { $p | ForEach-Object { Stop-Process -Id $_.ProcessId -Force } }"

                powershell -Command "$env:PORT='8082'; $env:DATA_DIR='data'; $env:JENKINS_NODE_COOKIE='dontKillMe'; Start-Process -FilePath 'java.exe' -ArgumentList '-jar','out\\attendance.jar' -WorkingDirectory (Get-Location) -WindowStyle Hidden"
            '''
        }
    }
}
        stage('Smoke Test') {
            steps {
                bat '''
                    powershell -Command "for ($i=0; $i -lt 20; $i++) { try { $r=Invoke-WebRequest http://localhost:8082/health -UseBasicParsing; if ($r.StatusCode -eq 200) { exit 0 } } catch {} ; Start-Sleep -Seconds 2 }; exit 1"
                '''
            }
        }
    }

    post {
        success {
            echo 'Attendance System deployed successfully!'
        }

        failure {
            echo 'Build/Test/Deployment failed.'
        }
    }
}

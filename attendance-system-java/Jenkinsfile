pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                bat 'test.bat'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                    taskkill /F /IM java.exe >nul 2>&1 || exit /b 0
                    set PORT=8082
                    set DATA_DIR=data
                    start "AttendanceSystem" /B java -jar out\\attendance.jar
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                bat '''
                    powershell -Command "for ($i=0; $i -lt 20; $i++) { try { $r=Invoke-WebRequest http://localhost:8082/health -UseBasicParsing; if ($r.StatusCode -eq 200) { exit 0 } } catch {} ; Start-Sleep -Seconds 2 }; exit 1"
                '''
            }
        }
    }

    post {
        success {
            echo 'Attendance System deployed successfully!'
        }

        failure {
            echo 'Build/Test/Deployment failed.'
        }
    }
}
